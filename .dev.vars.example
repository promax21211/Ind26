# Copy this file to .dev.vars for local development with `wrangler pages dev`.
# .dev.vars is gitignored — never commit real secrets.
#
# In production, set these with:
#   npx wrangler pages secret put SESSION_SECRET
#   npx wrangler pages secret put ADMIN_KEY

# Any long random string — used to sign session cookies.
SESSION_SECRET=replace-with-a-long-random-string

# Shared key required in the X-Admin-Key header to read /api/admin/* routes.
ADMIN_KEY=replace-with-a-long-random-string
